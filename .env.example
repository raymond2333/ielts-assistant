# Optional fallback API keys. After login, each user can save their own provider key in MySQL.
DASHSCOPE_API_KEY=your_dashscope_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key

# Set to true to persist login accounts, user API keys, profiles, and study progress in MySQL.
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ielts_learning

# Public addresses used by cross-version buttons after deployment.
# Prefer setting exact public URLs when using a server, domain, reverse proxy, or HTTPS.
# Do not set SERVER_DOMAIN to a private/internal address such as 10.x.x.x.
# If these are left unset, the app will infer links from the browser's current domain.
# SERVER_DOMAIN=your-public-domain.example.com
WEB_PORT=8600
STREAMLIT_PORT=8501
NEW_FLASK_URL=http://your-server-ip-or-domain:8600
LEGACY_STREAMLIT_URL=http://your-server-ip-or-domain:8501

# Optional default user shown in the sidebar.
IELTS_DEFAULT_USER_ID=default_user

# Flask admin users. Register/login with one of these user IDs to see the admin panel.
ADMIN_USER_IDS=admin
