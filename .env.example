# Optional fallback API keys. After login, each user can save their own provider key in MySQL.
DASHSCOPE_API_KEY=your_dashscope_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key

# Set to true to persist login accounts, user API keys, profiles, and study progress in MySQL.
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ielts_learning

# Optional default user shown in the sidebar.
IELTS_DEFAULT_USER_ID=default_user
